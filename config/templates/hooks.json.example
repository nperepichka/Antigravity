{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "auto-formatter": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write .",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "linter-guard": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --if-present",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "session-notifier": {
    "enabled": false,
    "Stop": [
      {
        "type": "command",
        "command": "echo 'Antigravity session step completed'",
        "timeout": 5
      }
    ]
  }
}
